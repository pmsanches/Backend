// Gerando relatório

const gerarRelatorio = (usuarios) => {
    let totalIdades = 0; 
    let ativos = 0;
    
    for (let usuario of usuarios) { 
        totalIdades = totalIdades + usuario.idade;

        if (usuario.ativo) { 
            ativos++; 
            } 
        } 
        
        const totalUsuarios = usuarios.length; 
        const usuariosAtivos = ativos; 
        const usuariosInativos = totalUsuarios - usuariosAtivos; 
        const mediaIdade = totalIdades / totalUsuarios; 
        const maior = maiorComprador(usuarios); 
        
        return { 
            totalUsuarios: totalUsuarios, 
            usuariosAtivos: usuariosAtivos, 
            usuariosInativos: usuariosInativos, 
            mediaIdade: mediaIdade, 
            maiorComprador: maior.nome 
            }; 
        };  

    const relatorio = gerarRelatorio(usuarios); 
    
    console.log("Relatório final:"); 
    console.log(relatorio);


