const usuarios = [
  { nome: "Ana", idade: 20, ativo: true, compras: [100, 50, 25] },
  { nome: "Bruno", idade: 17, ativo: false, compras: [30, 20] },
  { nome: "Carlos", idade: 32, ativo: true, compras: [200, 150, 50, 100] },
  { nome: "Diana", idade: 25, ativo: true, compras: [] },
  { nome: "Eduardo", idade: 15, ativo: false, compras: [10] }
];

// Total de compras por usuário

const totalCompras = (compras) => {
    let soma = 0;
    for (let valor of compras) {
        soma = soma + valor;
    }
    return soma;
};

for(let usuario of usuarios) {
    console.log(usuario.nome);
    console.log("R$:",totalCompras(usuario.compras));
}

//Usuários ativos

const usuariosAtivos =(usuarios) => {
    const ativos = [];

    for (let usuario of usuarios) {
        if (usuario.ativo){
            ativos.push(usuario);
        }
    }
    return ativos;
};

let ativos = usuariosAtivos(usuarios);

for (let usuario of ativos) {
    console.log(usuario.nome);
}

// Usuários maiores de idade

const usuariosMaiores = (usuarios) => {
    const maiores = [];

    for (let usuario of usuarios) {
        if (usuario.idade >= 18){
            maiores.push(usuario);
        }
    }
    return maiores
};

let maiores = usuariosMaiores(usuarios);

for (let usuario of maiores){
    console.log(usuario.nome);
}

// Maior volume de compras

const maiorComprador = (usuarios) => {
    let maiorUsuario = usuarios [0];
    let maiorTotal = totalCompras(usuarios[0].compras);

    for (let usuario of usuarios) {
        let total = totalCompras(usuario.compras);

        if (total > maiorTotal){
            maiorTotal = total;
            maiorUsuario = usuario;
        }
    }
    return maiorUsuario;
};

let usuarioMaiorCompra = maiorComprador(usuarios);

console.log("Usuário com maior valor de compras:",usuarioMaiorCompra.nome);
console.log("R$:", totalCompras(usuarioMaiorCompra.compras));

//Desafio coerção de tipos

console.log("5" + 2); // o código entendeu o 2 como string e fez a concatenação por conta do sinal utilizado, aqui pode gerar dupla interpretação e ele escolhe o tipo do primeiro valor
console.log("5" - 2); // o código entendeu o 2 como número e fez a subtração por conta do sinal utilizado
console.log(true + 1); // o código entendeu o valor de true como 1 e fez a soma com segundo número, pelo fato de não haver aspas leu os dois como número
console.log(false == 0); // o código entendeu o valor de false como 0 e fez a comparação com o número, sendo assim trazendo o true como resposta pois comparou somente o valor
console.log(false === 0); // o código entendeu o valor de false como 0 e fez a comparação com o número, sendo assim trazendo o false pois são iguais em valores e diferente em tipo

// Desafio Arrow Function vs Function

// Código 1

const pessoa = {
  nome: "Maria",
  falar: function(){
    console.log(this.nome);
  }
};

pessoa.falar();

// Código 2

const pessoas = {
  nome: "Maria",
  falar: () => {
    console.log(this.nome);
  }
};

pessoas.falar();

//Qual deles funciona corretamente?
// O primeiro funciona, o segundo funciona porém retorna undefined
//Por que o outro não funciona?
// Porque o arrow function não funciona bem com objetos, a arrow function não cria seu próprio this, ela utiliza o this do escopo onde ela foi definida
